# Biến cho docker compose (sao chép thành .env ở thư mục gốc, KHÔNG commit .env).
# Mật khẩu chỉ dùng chữ và số để không phải mã hóa trong DATABASE_URL.
POSTGRES_PASSWORD=
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự.
JWT_SECRET=
# Tùy chọn: để trống thì thực đơn và chat dùng thuật toán dự phòng.
OPENAI_API_KEY=
OPENAI_MODEL=
# Tùy chọn: model đọc ảnh cho quét hóa đơn (để trống = gpt-5-mini).
OPENAI_VISION_MODEL=
# Tùy chọn: gửi email (quên mật khẩu). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS là App Password.
# Để trống thì email chỉ ghi ra log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Tùy chọn: giờ gửi email nhắc đồ sắp hết hạn mỗi ngày, HH:mm giờ Việt Nam (để trống = 07:00).
EXPIRY_EMAIL_TIME=
# Tùy chọn: upload ảnh lên Cloudinary (đủ cả ba hoặc để trống cả ba).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Tùy chọn: số câu hỏi Hỏi Nouri tối đa mỗi người mỗi ngày (để trống = 30).
AI_CHAT_DAILY_LIMIT=
# Tùy chọn: số lần quét hóa đơn tối đa mỗi người mỗi ngày (để trống = 10).
RECEIPT_SCAN_DAILY_LIMIT=
# Tùy chọn (GĐ4): để trống = cookie đăng nhập chỉ gửi qua HTTPS/localhost; đặt false nếu mở demo bằng http qua IP mạng LAN.
COOKIE_SECURE=
# Tài khoản Admin do seed tạo (mật khẩu tối thiểu 8 ký tự). Để trống cả hai thì seed không tạo Admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true: seed cập nhật lại các món gốc theo seed-data.ts (ghi đè chỉnh sửa của Admin trên các món đó). Mặc định false.
SEED_UPDATE_RECIPES=

# Chỉ cho script nghiệm thu Playwright (e2e/acceptance), không dùng trong ứng dụng
DEMO_EMAIL=
DEMO_PASSWORD=
