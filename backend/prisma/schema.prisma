generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum HealthGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
  BUILD_MUSCLE
}

enum DietType {
  BALANCED
  VEGETARIAN
  VEGAN
  LOW_CARB
  HIGH_PROTEIN
}

enum FoodUnit {
  G
  KG
  ML
  L
  ITEM
  PACKAGE
}

enum StorageLocation {
  REFRIGERATOR
  FREEZER
  DRY_STORAGE
}

// Nguồn của một dòng lịch sử kho (GĐ3b): tiêu thụ (đã ăn), mua sắm (đã mua), nhập/sửa/xóa tay, quét ảnh (GĐ3c).
enum PantryTransactionSource {
  CONSUMPTION
  PURCHASE
  MANUAL_ADD
  MANUAL_EDIT
  MANUAL_DELETE
  RECEIPT_SCAN
}

// Lý do xóa thực phẩm khỏi kho (Báo cáo lãng phí). MISTAKE ("Nhập nhầm") không tính vào thống kê.
enum PantryRemovalReason {
  USED_UP
  DISCARDED
  MISTAKE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum NotificationType {
  PANTRY_EXPIRING
  PANTRY_EXPIRED
  PANTRY_LOW_STOCK
  MEAL_REMINDER
  MEAL_PLAN_CREATED
  MEAL_PREP_REMINDER
  COMMUNITY_LIKE
  COMMUNITY_COMMENT
  COMMUNITY_REPLY
  COMMUNITY_FOLLOW
  AI_RECIPE_SUGGESTION
  AI_EXPIRY_SUGGESTION
  AI_NUTRITION_SUGGESTION
}

// Quyền: tài khoản Admin chỉ tạo bằng seed (ADMIN_EMAIL/ADMIN_PASSWORD), không đăng ký công khai.
enum Role {
  USER
  ADMIN
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              Role               @default(USER)
  // Khác null: tài khoản đang bị khóa (không đăng nhập, không gọi API được); lưu thời điểm khóa.
  lockedAt          DateTime?
  // Tài khoản mẫu minh họa (seed, "Người dùng mẫu N", mauN@nouri.vn): có tương tác thật để thuật toán gợi ý cộng tác chạy khi
  // demo; không tính vào thống kê Admin, danh sách người dùng Admin gắn nhãn "Tài khoản mẫu".
  isSample          Boolean            @default(false)
  // Lần đổi mật khẩu gần nhất (GĐ4): access token phát trước thời điểm này bị từ chối.
  passwordChangedAt DateTime?
  refreshTokens     RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  expiryEmailLogs   ExpiryEmailLog[]
  favoriteRecipes   FavoriteRecipe[]
  savedPosts        SavedPost[]
  profile           NutritionProfile?
  pantryItems       PantryItem[]
  pantryTransactions PantryTransaction[]
  receiptScans      ReceiptScan[]
  mealPlans         MealPlan[]
  chatMessages      ChatMessage[]
  communityPosts    CommunityPost[]
  communityLikes    CommunityLike[]
  communityComments CommunityComment[]
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum AdminAuditAction {
  RECIPE_CREATE
  RECIPE_UPDATE
  RECIPE_HIDE
  RECIPE_SHOW
  RECIPE_DELETE
  RECIPE_RESTORE
  RECIPE_IMAGE_REPLACE
  USER_LOCK
  USER_UNLOCK
  POST_DELETE
  COMMENT_DELETE
  POST_HIDE
  POST_SHOW
  POST_PROMOTE
  POST_APPROVE
}

enum AdminAuditTargetType {
  RECIPE
  USER
  COMMUNITY_POST
  COMMUNITY_COMMENT
}

// Nhật ký thao tác Admin, ghi trong cùng transaction với thao tác. Không lưu mật khẩu, token, nội dung bài/bình luận.
model AdminAuditLog {
  id          String               @id @default(cuid())
  // Restrict: tài khoản Admin đã có nhật ký không bị xóa mất dấu vết (hiện chưa có chức năng xóa tài khoản).
  actorId     String
  actor       User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      AdminAuditAction
  targetType  AdminAuditTargetType
  // Không có FK: đối tượng (món, bài, bình luận) có thể đã bị xóa nhưng nhật ký vẫn phải còn.
  targetId    String
  // Tên món hoặc email người dùng/tác giả tại thời điểm thao tác.
  targetLabel String?
  // Chi tiết theo từng loại thao tác (danh sách trường cố định, xem admin-audit.service.ts).
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model CommunityPost {
  id        String             @id @default(cuid())
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  // Công thức có sẵn được gắn kèm (tùy chọn). Restrict: công thức đã được bài viết gắn thì không xóa hẳn, Admin xóa thì chuyển thành xóa mềm (`Recipe.deletedAt`).
  recipeId  String?
  recipe    Recipe?            @relation("CommunityPostRecipe", fields: [recipeId], references: [id], onDelete: Restrict)
  // Công thức tự viết của thành viên (JSON: tên, khẩu phần, phút, nguyên liệu {tên, số lượng, đơn vị} nhập tự do, các bước).
  // Không phải Recipe: không vào thực đơn, gợi ý, kho. Không đồng thời với recipeId. Kiểm tra bằng Zod (community-member-recipe.ts).
  memberRecipe Json?
  // Khác null: Admin ẩn bài (không hiện ở bảng tin của người khác; tác giả vẫn thấy kèm ghi chú).
  hiddenAt  DateTime?
  // AI kiểm duyệt (Moderation API + kiểm tra "có liên quan ăn uống"): nghi vấn → khác null, bài chờ Admin duyệt, chỉ tác giả thấy.
  // AI không bao giờ tự xóa bài; không có key/API lỗi thì đăng như thường. aiReviewReason: lý do AI (giữ lại sau khi duyệt).
  pendingReviewAt DateTime?
  aiReviewReason  String?
  // Admin "Chuyển thành công thức": món mới tạo từ công thức tự viết. SetNull: xóa món thì bài chỉ mất liên kết.
  promotedRecipeId String?
  promotedRecipe   Recipe?         @relation("CommunityPostPromotedRecipe", fields: [promotedRecipeId], references: [id], onDelete: SetNull)
  images    CommunityPostImage[]
  likes     CommunityLike[]
  comments  CommunityComment[]
  savedBy   SavedPost[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([recipeId])
  @@index([promotedRecipeId])
}

// Ảnh trong bài viết (tối đa 4, lưu trên Cloudinary thư mục nouri/posts, đã xóa EXIF/GPS trước khi tải lên).
model CommunityPostImage {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  position  Int
  createdAt DateTime      @default(now())

  @@index([postId, position])
}

model CommunityLike {
  postId    String
  userId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  relatedId String?
  actionUrl String?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model NutritionProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  gender             Gender?
  heightCm           Float?
  weightKg           Float?
  targetWeightKg     Float?
  activityLevel      ActivityLevel @default(MODERATE)
  goal               HealthGoal    @default(MAINTAIN)
  dietType           DietType      @default(BALANCED)
  allergies          String[]
  dislikedFoods      String[]
  preferredCuisines  String[]
  mealsPerDay        Int           @default(3)
  dailyCalorieTarget Int?
  proteinTargetG     Int?
  carbTargetG        Int?
  fatTargetG         Int?
  // Nhắc đồ sắp hết hạn qua email (người dùng tự bật; demo bật sẵn trong demo:reset), báo trước 1–3 ngày.
  expiryEmailEnabled Boolean       @default(false)
  expiryEmailDays    Int           @default(2)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model PantryItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  quantity     Float
  unit         FoodUnit
  storageLocation StorageLocation @default(REFRIGERATOR)
  expiryDate   DateTime?
  purchasedAt  DateTime  @default(now())
  minimumStock Float     @default(0)
  note         String?
  // Hạn do hệ thống gợi ý theo nhóm (đã mua, quét ảnh), chưa được người dùng xác nhận; người dùng sửa hạn thì về false.
  expiryEstimated Boolean @default(false)
  // Đơn giá (đồng / 1 đơn vị của unit), tùy chọn: người dùng nhập hoặc lấy từ hóa đơn có giá. Dùng ước tính tiền lãng phí.
  unitPrice    Float?
  transactions PantryTransaction[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, expiryDate])
  @@index([userId, category])
}

// Lịch sử xuất/nhập kho. Ghi cùng transaction với thay đổi kho. Chụp lại tên và đơn vị lúc ghi để lịch sử còn đọc được
// sau khi thực phẩm bị sửa/xóa (pantryItemId về null khi xóa). delta: + nhập, − xuất, theo `unit`; quantityAfter: số lượng
// sau thay đổi. Dòng hoàn lại (bỏ "đã ăn"/"đã mua") trỏ về dòng gốc qua reversalOfId; dòng gốc có reversedAt.
model PantryTransaction {
  id             String                  @id @default(cuid())
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pantryItemId   String?
  pantryItem     PantryItem?             @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
  itemName       String
  unit           FoodUnit
  delta          Float
  quantityAfter  Float
  source         PantryTransactionSource
  note           String?
  mealPlanItemId String?
  mealPlanItem   MealPlanItem?           @relation(fields: [mealPlanItemId], references: [id], onDelete: SetNull)
  shoppingItemId String?
  shoppingItem   ShoppingItem?           @relation(fields: [shoppingItemId], references: [id], onDelete: SetNull)
  reversalOfId   String?
  reversalOf     PantryTransaction?      @relation("PantryTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals      PantryTransaction[]     @relation("PantryTransactionReversal")
  reversedAt     DateTime?
  // Lô quét hóa đơn (GĐ3c) đã thêm dòng này; hoàn tác lô trừ lại mọi dòng cùng receiptScanId.
  receiptScanId  String?
  receiptScan    ReceiptScan?            @relation(fields: [receiptScanId], references: [id], onDelete: SetNull)
  // Báo cáo lãng phí: lý do khi xóa khỏi kho, và ảnh chụp nhóm, hạn, đơn giá lúc thay đổi (thực phẩm bị xóa thì vẫn thống kê được).
  removalReason  PantryRemovalReason?
  category       String?
  expiryDate     DateTime?
  unitPrice      Float?
  createdAt      DateTime                @default(now())

  @@index([userId, createdAt])
  @@index([pantryItemId, createdAt])
  @@index([mealPlanItemId])
  @@index([shoppingItemId])
  @@index([receiptScanId])
}

enum ReceiptOcrProvider {
  TESSERACT
  OPENAI
  MOCK
}

enum ReceiptScanStatus {
  PROCESSING
  READY
  COMMITTED
  REVERSED
  FAILED
}

// Một lần quét hóa đơn (GĐ3c). Không lưu ảnh, không lưu văn bản đọc được; dòng nháp chỉ giữ trong bộ nhớ server.
// Dùng để đếm số lần quét mỗi ngày (kể cả lần lỗi) và gom các dòng lịch sử kho của một lần lưu để hoàn tác cả lô.
model ReceiptScan {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     ReceiptOcrProvider
  status       ReceiptScanStatus   @default(PROCESSING)
  lineCount    Int                 @default(0)
  durationMs   Int?
  errorCode    String?
  /// Token OpenAI vào/ra của lần quét (tính chi phí); null với Tesseract.
  inputTokens  Int?
  outputTokens Int?
  /// Chế độ "Tự động": lý do OpenAI lỗi rồi chuyển Tesseract (OPENAI_TIMEOUT | OPENAI_INVALID_OUTPUT | OPENAI_FAILED).
  fallbackCode String?
  committedAt  DateTime?
  reversedAt   DateTime?
  transactions PantryTransaction[]
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
}

model Recipe {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  description  String
  instructions String[]
  prepMinutes  Int
  cookMinutes  Int
  servings     Int                @default(1)
  calories     Int
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float              @default(0)
  dietTags     DietType[]
  mealTypes    MealType[]         @default([])
  cuisine      String
  imageUrl     String?
  // publicId trên Cloudinary của ảnh do Admin tải lên (null với ảnh nhóm món /assets); dùng để xóa ảnh cũ khi thay.
  imagePublicId String?
  // Khác null: món đã ngừng sử dụng (Admin ẩn thay vì xóa món đã được dùng). Không hiện ở danh sách, không chọn được
  // khi tạo thực đơn/đăng bài; trang chi tiết, thực đơn cũ và bài viết cũ vẫn hiển thị.
  hiddenAt     DateTime?
  // Admin xóa món đã được tham chiếu (thực đơn, bài viết): xóa mềm — ẩn khỏi mọi danh sách/gợi ý/chọn mới,
  // thực đơn và bài cũ vẫn hiện tên kèm "món đã bị xóa". Món chưa được tham chiếu thì xóa hẳn.
  deletedAt    DateTime?
  ingredients  RecipeIngredient[]
  mealItems    MealPlanItem[]
  communityPosts CommunityPost[] @relation("CommunityPostRecipe")
  promotedFromPosts CommunityPost[] @relation("CommunityPostPromotedRecipe")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([cuisine])
  @@index([hiddenAt])
  favoritedBy  FavoriteRecipe[]
}

model RecipeIngredient {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     FoodUnit
  optional Boolean  @default(false)

  @@index([recipeId])
}

model MealPlan {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime
  endDate       DateTime
  status        PlanStatus     @default(DRAFT)
  calorieTarget Int
  aiGenerated   Boolean        @default(false)
  summary       String?
  days          MealPlanDay[]
  shoppingItems ShoppingItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, startDate])
}

model MealPlanDay {
  id         String         @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  date       DateTime
  note       String?
  items      MealPlanItem[]

  @@unique([mealPlanId, date])
}

model MealPlanItem {
  id        String      @id @default(cuid())
  dayId     String
  day       MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe      @relation(fields: [recipeId], references: [id])
  mealType  MealType
  servings  Float       @default(1)
  completed Boolean     @default(false)
  calories  Int
  pantryTransactions PantryTransaction[]

  @@index([dayId, mealType])
}

model ShoppingItem {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float
  unit       FoodUnit
  purchased  Boolean  @default(false)
  category   String?
  pantryTransactions PantryTransaction[]

  @@index([mealPlanId, purchased])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Refresh token (GĐ4): chỉ lưu SHA-256 của token (token gốc nằm trong cookie httpOnly). Mỗi lần làm mới, token cũ được đánh dấu
// usedAt và phát token mới cùng familyId (xoay vòng). Dùng lại token đã xoay → thu hồi cả chuỗi (familyId).
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  // true: "Nhớ đăng nhập" (cookie 30 ngày); false: cookie phiên.
  remember  Boolean
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

// Quên mật khẩu (giai-doan-email): token ngẫu nhiên 32 byte gửi qua email, DB chỉ lưu SHA-256; hết hạn 30 phút, dùng một lần
// (usedAt). Yêu cầu mới xóa các token cũ của người đó.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Email nhắc đồ sắp hết hạn đã gửi. Dòng được tạo TRƯỚC khi gửi và làm khóa: unique (userId, dayKey, slot) → chạy lịch nhiều lần
// hay nhiều tiến trình cũng chỉ một email/ngày ("daily"); "test-1..3" là các lần "Gửi thử ngay". itemKeys: "pantryItemId:yyyy-MM-dd"
// (id + hạn) của món đã nhắc, để không nhắc lại cùng món trừ khi hạn còn 1 ngày.
model ExpiryEmailLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayKey    String
  slot      String
  itemKeys  String[]
  createdAt DateTime @default(now())

  @@unique([userId, dayKey, slot])
  @@index([userId, createdAt])
}

// UC24 Yêu thích công thức: một người một món một lần. Cũng là tín hiệu "LIKED" cho bộ gợi ý (interaction-loader.ts, cùng trọng số
// với thích bài gắn món). Xóa người dùng / món → xóa theo.
model FavoriteRecipe {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
  @@index([recipeId])
}

// UC25 Lưu bài viết (chỉ chủ tài khoản thấy). Bài bị xóa → dòng lưu xóa theo; bài bị ẩn / chờ duyệt → không hiện trong "Bài đã lưu".
model SavedPost {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@index([postId])
}
