generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum HealthGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_WEIGHT
  BUILD_MUSCLE
}

enum DietType {
  BALANCED
  VEGETARIAN
  VEGAN
  LOW_CARB
  HIGH_PROTEIN
}

enum FoodUnit {
  G
  KG
  ML
  L
  ITEM
  PACKAGE
}

enum StorageLocation {
  REFRIGERATOR
  FREEZER
  DRY_STORAGE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum NotificationType {
  PANTRY_EXPIRING
  PANTRY_EXPIRED
  PANTRY_LOW_STOCK
  MEAL_REMINDER
  MEAL_PLAN_CREATED
  MEAL_PREP_REMINDER
  COMMUNITY_LIKE
  COMMUNITY_COMMENT
  COMMUNITY_REPLY
  COMMUNITY_FOLLOW
  AI_RECIPE_SUGGESTION
  AI_EXPIRY_SUGGESTION
  AI_NUTRITION_SUGGESTION
}

// Quyền: tài khoản Admin chỉ tạo bằng seed (ADMIN_EMAIL/ADMIN_PASSWORD), không đăng ký công khai.
enum Role {
  USER
  ADMIN
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              Role               @default(USER)
  // Khác null: tài khoản đang bị khóa (không đăng nhập, không gọi API được); lưu thời điểm khóa.
  lockedAt          DateTime?
  profile           NutritionProfile?
  pantryItems       PantryItem[]
  mealPlans         MealPlan[]
  chatMessages      ChatMessage[]
  communityPosts    CommunityPost[]
  communityLikes    CommunityLike[]
  communityComments CommunityComment[]
  notifications     Notification[]
  adminAuditLogs    AdminAuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

enum AdminAuditAction {
  RECIPE_CREATE
  RECIPE_UPDATE
  RECIPE_HIDE
  RECIPE_SHOW
  RECIPE_DELETE
  RECIPE_IMAGE_REPLACE
  USER_LOCK
  USER_UNLOCK
  POST_DELETE
  COMMENT_DELETE
}

enum AdminAuditTargetType {
  RECIPE
  USER
  COMMUNITY_POST
  COMMUNITY_COMMENT
}

// Nhật ký thao tác Admin, ghi trong cùng transaction với thao tác. Không lưu mật khẩu, token, nội dung bài/bình luận.
model AdminAuditLog {
  id          String               @id @default(cuid())
  // Restrict: tài khoản Admin đã có nhật ký không bị xóa mất dấu vết (hiện chưa có chức năng xóa tài khoản).
  actorId     String
  actor       User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action      AdminAuditAction
  targetType  AdminAuditTargetType
  // Không có FK: đối tượng (món, bài, bình luận) có thể đã bị xóa nhưng nhật ký vẫn phải còn.
  targetId    String
  // Tên món hoặc email người dùng/tác giả tại thời điểm thao tác.
  targetLabel String?
  // Chi tiết theo từng loại thao tác (danh sách trường cố định, xem admin-audit.service.ts).
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model CommunityPost {
  id        String             @id @default(cuid())
  authorId  String
  author    User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  // Công thức có sẵn được gắn kèm (tùy chọn). Restrict: công thức đã được bài viết gắn thì không xóa hẳn được (GĐ3: chỉ ẩn).
  recipeId  String?
  recipe    Recipe?            @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  images    CommunityPostImage[]
  likes     CommunityLike[]
  comments  CommunityComment[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([recipeId])
}

// Ảnh trong bài viết (tối đa 4, lưu trên Cloudinary thư mục nouri/posts, đã xóa EXIF/GPS trước khi tải lên).
model CommunityPostImage {
  id        String        @id @default(cuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  position  Int
  createdAt DateTime      @default(now())

  @@index([postId, position])
}

model CommunityLike {
  postId    String
  userId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
  @@index([userId, createdAt])
}

model CommunityComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  relatedId String?
  actionUrl String?
  dedupeKey String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model NutritionProfile {
  id                 String        @id @default(cuid())
  userId             String        @unique
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  age                Int?
  gender             Gender?
  heightCm           Float?
  weightKg           Float?
  targetWeightKg     Float?
  activityLevel      ActivityLevel @default(MODERATE)
  goal               HealthGoal    @default(MAINTAIN)
  dietType           DietType      @default(BALANCED)
  allergies          String[]
  dislikedFoods      String[]
  preferredCuisines  String[]
  mealsPerDay        Int           @default(3)
  dailyCalorieTarget Int?
  proteinTargetG     Int?
  carbTargetG        Int?
  fatTargetG         Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model PantryItem {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  quantity     Float
  unit         FoodUnit
  storageLocation StorageLocation @default(REFRIGERATOR)
  expiryDate   DateTime?
  purchasedAt  DateTime  @default(now())
  minimumStock Float     @default(0)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, expiryDate])
  @@index([userId, category])
}

model Recipe {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  description  String
  instructions String[]
  prepMinutes  Int
  cookMinutes  Int
  servings     Int                @default(1)
  calories     Int
  proteinG     Float
  carbsG       Float
  fatG         Float
  fiberG       Float              @default(0)
  dietTags     DietType[]
  mealTypes    MealType[]         @default([])
  cuisine      String
  imageUrl     String?
  // publicId trên Cloudinary của ảnh do Admin tải lên (null với ảnh nhóm món /assets); dùng để xóa ảnh cũ khi thay.
  imagePublicId String?
  // Khác null: món đã ngừng sử dụng (Admin ẩn thay vì xóa món đã được dùng). Không hiện ở danh sách, không chọn được
  // khi tạo thực đơn/đăng bài; trang chi tiết, thực đơn cũ và bài viết cũ vẫn hiển thị.
  hiddenAt     DateTime?
  ingredients  RecipeIngredient[]
  mealItems    MealPlanItem[]
  communityPosts CommunityPost[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([cuisine])
  @@index([hiddenAt])
}

model RecipeIngredient {
  id       String   @id @default(cuid())
  recipeId String
  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  quantity Float
  unit     FoodUnit
  optional Boolean  @default(false)

  @@index([recipeId])
}

model MealPlan {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  startDate     DateTime
  endDate       DateTime
  status        PlanStatus     @default(DRAFT)
  calorieTarget Int
  aiGenerated   Boolean        @default(false)
  summary       String?
  days          MealPlanDay[]
  shoppingItems ShoppingItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, startDate])
}

model MealPlanDay {
  id         String         @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan       @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  date       DateTime
  note       String?
  items      MealPlanItem[]

  @@unique([mealPlanId, date])
}

model MealPlanItem {
  id        String      @id @default(cuid())
  dayId     String
  day       MealPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe      @relation(fields: [recipeId], references: [id])
  mealType  MealType
  servings  Float       @default(1)
  completed Boolean     @default(false)
  calories  Int

  @@index([dayId, mealType])
}

model ShoppingItem {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  name       String
  quantity   Float
  unit       FoodUnit
  purchased  Boolean  @default(false)
  category   String?

  @@index([mealPlanId, purchased])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
