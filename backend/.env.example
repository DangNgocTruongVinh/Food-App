# Chạy backend ngoài Docker: sao chép thành backend/.env và điền giá trị (KHÔNG commit .env).
NODE_ENV=
PORT=
FRONTEND_URL=
# Dạng postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public
DATABASE_URL=
# Chuỗi ngẫu nhiên tối thiểu 32 ký tự.
JWT_SECRET=
# Tùy chọn: để trống thì thực đơn và chat dùng thuật toán dự phòng.
OPENAI_API_KEY=
OPENAI_MODEL=
# Tùy chọn: model đọc ảnh cho quét hóa đơn (để trống = gpt-5-mini).
OPENAI_VISION_MODEL=
# Tùy chọn: số câu hỏi Hỏi Nouri tối đa mỗi người mỗi ngày (để trống = 30).
AI_CHAT_DAILY_LIMIT=
# Tùy chọn: gửi email (quên mật khẩu). Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS là App Password.
# Để trống thì email chỉ ghi ra log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Tùy chọn: chuyển mọi email gửi tài khoản demo (demo@nouri.vn) tới hộp thư thật này để xem khi demo.
DEMO_EMAIL_INBOX=
# Tùy chọn: giờ gửi email nhắc đồ sắp hết hạn mỗi ngày, HH:mm giờ Việt Nam (để trống = 07:00).
EXPIRY_EMAIL_TIME=
# Tùy chọn: upload ảnh lên Cloudinary (đủ cả ba hoặc để trống cả ba).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Chỉ seed đọc (xem src/config/seed-env.ts).
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_UPDATE_RECIPES=
